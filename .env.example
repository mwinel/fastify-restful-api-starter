DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastify_auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
PORT=4000
# Select resend (default), postmark, or nodemailer.
EMAIL_PROVIDER=resend
MAIL_FROM=Example <auth@example.com>
# Set only the credentials for the selected provider.
RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
REQUIRE_EMAIL_2FA=false

# For a self-hosted production API, configure the durable workflow backend.
# WORKFLOW_TARGET_WORLD=@workflow/world-postgres
# WORKFLOW_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/fastify_auth
